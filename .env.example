# Normal builds download assets from the latest published stable Datalith release.
# Copy this file to .env only when you want an explicit development override.

# Use a branch or a particular release instead:
# DATALITH_SOURCE_REF=main
# DATALITH_SOURCE_REF=v1.1.0

# Use uncommitted assets from a local app checkout (not allowed in CI):
# DATALITH_SOURCE_DIR=../datalith-app

# Optional read-only token to raise the GitHub release API rate limit.
# Public asset clones do not require authentication.
# DATALITH_READ_TOKEN=
