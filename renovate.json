{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["local>mycelium-build/datalith-app//.github/renovate/preset"],
    "packageRules": [
        {
            "description": "THIRD-PARTY-NOTICES.md lists dependency versions: regenerate it with every npm update.",
            "matchManagers": ["npm"],
            "postUpgradeTasks": {
                "commands": ["scripts/renovate-post-upgrade.sh"],
                "fileFilters": ["THIRD-PARTY-NOTICES.md"],
                "executionMode": "branch"
            }
        }
    ]
}
