{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["local>mycelium-build/datalith-app//.github/renovate/preset"],
    "packageRules": [
        {
            "description": "THIRD-PARTY-NOTICES.md lists dependency versions: regenerate it with every npm update.",
            "matchManagers": ["npm"],
            "postUpgradeTasks": {
                "commands": ["scripts/renovate-post-upgrade.sh"],
                "fileFilters": ["THIRD-PARTY-NOTICES.md"],
                "executionMode": "branch"
            }
        },
        {
            "description": "Keep the Vite+ core alias and bundled test runner together, including npm overrides.",
            "matchPackageNames": ["vite", "vite-plus", "vitest", "@voidzero-dev/**"],
            "groupName": "vite-plus",
            "separateMajorMinor": false,
            "commitMessagePrefix": "chore(deps):"
        }
    ]
}
