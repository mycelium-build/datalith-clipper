{
    "manifest_version": 3,
    "name": "Datalith Clipper",
    "version": "0.0.1",
    "description": "Save web pages as notes into your Datalith vaults.",
    "minimum_chrome_version": "116",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Datalith Clipper",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background/main.js"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content/main.js"],
            "run_at": "document_idle"
        }
    ],
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "permissions": ["storage"],
    "host_permissions": ["http://127.0.0.1:42908/*"],
    "commands": {
        "toggle-highlighter": {
            "suggested_key": { "default": "Alt+Shift+H" },
            "description": "Toggle highlighter"
        },
        "open-clipper": {
            "suggested_key": { "default": "Alt+Shift+O" },
            "description": "Open Datalith Clipper"
        },
        "toggle-reader": {
            "suggested_key": { "default": "Alt+Shift+R" },
            "description": "Toggle reader"
        }
    }
}
